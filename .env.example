# Server-side Web Push settings. Never expose the private key in VITE_ variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Upstash Redis REST credentials for scheduled reminders
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron authentication secret
CRON_SECRET=
